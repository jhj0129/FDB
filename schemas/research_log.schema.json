{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jhj0129/FDB/schemas/research_log.schema.json",
  "title": "FDB Research Log",
  "type": "object",
  "required": [
    "schema_version", "research_id", "created_at", "question", "search_queries",
    "sources", "cross_checks", "interpretation", "hypotheses", "validation",
    "confidence", "unresolved_questions", "status"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "research_id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "question": {"type": "string", "minLength": 1},
    "search_queries": {"type": "array", "items": {"type": "string"}},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "locator", "retrieved_at", "claims"]
      }
    },
    "cross_checks": {"type": "array"},
    "interpretation": {"type": "string"},
    "hypotheses": {"type": "array"},
    "validation": {"type": "object"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "unresolved_questions": {"type": "array"},
    "status": {"enum": ["open", "validated", "rejected", "superseded", "archived"]}
  },
  "additionalProperties": false
}

